# Godot's import cache and editor state. Regenerated on first open; never committed.
game/.godot/

# Exported builds.
builds/
*.dmg
*.exe
*.zip

# The abandoned three.js prototype, kept on disk for reference but not in the repo.
Niepotrzebne/

# Rendered UI previews — regenerated by tools/shoot_ui.gd, not project content.
shots/

# Texture dumps written by models/mk50-recolour.py while it works. Debug output, not input:
