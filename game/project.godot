; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mark Zero"
config/description="Fly a powered armour suit over New York. Controller only."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.05, 0.07, 1)
boot_splash/show_image=false

[autoload]

Pad="*res://scripts/core/pad.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

; Every run leaves a log on disk. The machine this game is played on is a laptop in another
; room, so "be sitting there when it fails" is not a debugging strategy.
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/mark-zero.log"
file_logging/max_log_files=5

; NOTE: Godot's editor rewrites this file and removes every setting that equals its own
; default, so a line deleted here after opening the editor was a no-op anyway. Only settings
; whose value the game genuinely depends on are worth keeping — the 120 Hz physics step, on
; which every ported flight constant was tuned, and Jolt.

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.09, 1)
anti_aliasing/quality/screen_space_aa=1
