; Engine configuration file.

config_version=5

[application]

config/name="Mark Zero"
config/description="Fly a powered armour suit over New York. Controller only."
run/main_scene="res://scenes/world/arena.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.05, 0.07, 1)
boot_splash/minimum_display_time=0

[autoload]

Pad="*res://scripts/core/pad.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

; The mouse is never used. Captured anyway so a stray click cannot pull focus out
; of the game while a controller is driving it.
pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
; The flight model was authored against a 120 Hz fixed step in the browser build and
; its constants — brake authority, fall arrest, the climb governor — are tuned to it.
; Keeping 120 here means those numbers port as they are instead of being re-found.
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.09, 1)
